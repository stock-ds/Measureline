# Copy to keystore.properties (gitignored) and fill in your upload key.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/pocketarrows-upload.jks -alias pocketarrows -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/pocketarrows-upload.jks
storePassword=CHANGE_ME
keyAlias=pocketarrows
keyPassword=CHANGE_ME
