# Copy to keystore.properties (gitignored) and fill in your upload key.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/measureline-upload.jks -alias measureline -keyalg RSA -keysize 2048 -validity 10000
storeFile=keystore/measureline-upload.jks
storePassword=CHANGE_ME
keyAlias=measureline
keyPassword=CHANGE_ME
